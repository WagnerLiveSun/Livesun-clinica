# SunSet — configuração local
# O iniciar-local.bat copia este arquivo para .env na primeira execução.

# Obrigatório: conexão MySQL 8+ criada por database/sunset_schema_mysql.sql.
DATABASE_URL=mysql://USUARIO:SENHA@localhost:3306/sunset

# Obrigatório: gere uma chave longa, única e aleatória para assinar as sessões.
JWT_SECRET=troque-por-uma-chave-aleatoria-longa-e-unica

# Obrigatório para criptografar API keys e outros segredos armazenados no MySQL.
APP_MASTER_KEY=troque-por-outra-chave-aleatoria-longa-e-unica

# Scheduler interno de lembretes (0 desativa; padrão: 5 minutos).
SCHEDULER_SECRET=troque-por-um-segredo-do-scheduler
REMINDER_INTERVAL_MS=300000

# Diretório local para fotos e logos enviados pela aplicação.
STORAGE_DIR=./storage

# Opcional: identidade visual local.
VITE_APP_TITLE=SunSet
VITE_APP_LOGO=

# Opcional: confirmação e lembretes por e-mail via Brevo.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Mantenha vazios até configurar e autorizar os respectivos canais no Brevo.
BREVO_SMS_SENDER=
BREVO_WHATSAPP_SENDER=
BREVO_WHATSAPP_TEMPLATE_ID=

